{
  "name": "portfolio2024",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "clean": "pnpm -r exec rm -rf node_modules dist",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build",
    "backend:dev": "pnpm --filter backend dev",
    "backend:bunyan": "pnpm --filter backend dev:pretty",
    "backend:build": "pnpm --filter backend build",
    "common:build": "pnpm --filter common build",
    "start:all": "pnpm run backend:bunyan & pnpm run frontend:dev",
    "db:up": "docker compose -f packages/backend/docker-compose.test.yml up -d",
    "db:down": "docker compose -f packages/backend/docker-compose.test.yml down",
    "db:logs": "docker compose -f packages/backend/docker-compose.test.yml logs -f postgres"
  },
  "devDependencies": {
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.31.0"
  }
}
